---
/*
  Selected work as a large square grid.
  On fine-pointer devices each card can be dragged (and thrown) around,
  constrained to the board so nothing ever overflows the page.
*/
const projects = [
  { title: "Lorem Ipsum", client: "Dolor Co.", role: "Art Direction", year: "2026",
    art: "radial-gradient(circle at 30% 40%, #f2f0eb 0 18%, transparent 18.5%), repeating-linear-gradient(90deg, #0a0a0a 0 14px, #1c1c1c 14px 28px)" },
  { title: "Sit Amet", client: "Consectetur", role: "Brand Identity", year: "2025",
    art: "conic-gradient(from 90deg at 50% 50%, #ff3b00, #0a0a0a 25%, #f2f0eb 50%, #0a0a0a 75%, #ff3b00)" },
  { title: "Adipiscing", client: "Elit Studio", role: "Web Design", year: "2025",
    art: "repeating-radial-gradient(circle at 70% 70%, #f2f0eb 0 2px, #0a0a0a 2px 16px)" },
  { title: "Tempor Inc.", client: "Incididunt", role: "Creative Direction", year: "2024",
    art: "linear-gradient(135deg, #0a0a0a 0 40%, #ff3b00 40% 60%, #f2f0eb 60%)" },
  { title: "Magna Aliqua", client: "Ut Enim", role: "Campaign", year: "2024",
    art: "repeating-conic-gradient(#f2f0eb 0 25%, #0a0a0a 0 50%) 0 0 / 48px 48px" },
  { title: "Veniam", client: "Quis Nostrud", role: "Motion System", year: "2023",
    art: "radial-gradient(ellipse at 50% 120%, #ff3b00 0 30%, #0a0a0a 60%), #0a0a0a" },
];
---

<section id="work" class="relative py-[12vh]" data-work>
  <div class="grid-site mb-10 items-end gap-y-4">
    <p class="label col-span-3 md:col-span-2" data-reveal>(02) — Selected Work</p>
    <h2 class="display col-span-6 text-[clamp(3rem,11vw,12rem)] md:col-span-8 md:row-start-1 md:col-start-3" data-split-chars>
      Work<span class="serif-i text-hit">(s)</span>
    </h2>
    <p class="label col-span-3 text-right text-mute md:col-span-2 md:col-start-11 md:row-start-1" data-reveal>
      2019 — 2026<br />{String(projects.length).padStart(2, "0")} Entries
    </p>
  </div>

  <!-- Board controls (drag-capable devices only) -->
  <div class="grid-site label mb-4 hidden items-center [@media(hover:hover)_and_(pointer:fine)]:grid" data-board-controls>
    <p class="col-span-6 text-mute md:col-span-6">
      <span class="text-hit">✦</span> Drag &amp; throw the work around. It stays inside the frame.
    </p>
    <div class="col-span-6 flex justify-end gap-2 md:col-span-6">
      <button type="button" class="cursor-pointer border border-line px-3 py-1.5 transition-colors hover:border-paper" data-board-scatter data-cursor>
        Scatter
      </button>
      <button type="button" class="cursor-pointer border border-line px-3 py-1.5 transition-colors hover:border-paper" data-board-reset data-cursor>
        Reset grid
      </button>
    </div>
  </div>

  <div class="px-[var(--margin)]">
    <!-- The board is the drag bounds: no padding, so cards can't enter the page margins -->
    <ul class="relative grid grid-cols-6 gap-[var(--gutter)] md:grid-cols-12" data-work-board>
      {
        projects.map((p, i) => (
          <li class="relative col-span-6 sm:col-span-3 md:col-span-4" data-work-card>
            <a
              href="#"
              class="group relative block aspect-square overflow-hidden bg-[#141414] outline-offset-4 select-none"
              aria-label={`${p.title} — ${p.client}, ${p.role}, ${p.year}`}
              draggable="false"
              data-cursor-drag
              data-card-inner
            >
              <div
                class="absolute -inset-[8%] transition-transform duration-[1.2s] ease-expo group-hover:scale-[1.06]"
                style={`background:${p.art}`}
                data-card-art
              />
              <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/10 to-ink/40" />

              <div class="label absolute inset-x-0 top-0 flex justify-between p-4 text-paper">
                <span>{String(i + 1).padStart(2, "0")} / {String(projects.length).padStart(2, "0")}</span>
                <span>{p.year}</span>
              </div>

              <div class="absolute inset-x-0 bottom-0 p-4">
                <p class="label mb-2 flex justify-between text-paper/70">
                  <span>{p.client}</span>
                  <span>{p.role}</span>
                </p>
                <h3 class="display text-[clamp(2rem,4.4vw,4.75rem)] leading-[0.85] text-paper transition-[font-stretch,color] duration-700 ease-expo group-hover:text-hit group-hover:[font-stretch:125%]">
                  {p.title}
                </h3>
              </div>

              <span class="label absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-ink px-1.5 py-0.5 text-mute">
                Placeholder
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
