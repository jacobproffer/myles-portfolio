---
/* The one-page site. Rendered statically at / and on request at /preview. */
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import Intro from "@components/Intro.astro";
import WorkIndex from "@components/WorkIndex.astro";
import Capabilities from "@components/Capabilities.astro";
import Marquee from "@components/Marquee.astro";
import InfoGrid from "@components/InfoGrid.astro";

interface Props {
  noindex?: boolean;
}
---

<BaseLayout pageTitle="Myles Kedrowski — Art Director" noindex={Astro.props.noindex}>
  <Hero first="Myles" last="Kedrowski" />
  <Marquee />
  <Intro />
  <WorkIndex />
  <Capabilities />
  <InfoGrid />
  <slot />
</BaseLayout>
