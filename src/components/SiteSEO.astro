---
import { SEO, type Props as SEOProps } from "astro-seo";
import { getSiteSettings, urlFor } from "@lib/sanity";

const settings = await getSiteSettings(Astro.locals);
const shareImage = settings.shareImage?.asset
  ? urlFor(settings.shareImage).width(1200).height(630).fit("crop").url()
  : new URL("/images/social.jpg", Astro.url).toString();
const shareSize = { width: 1200, height: 630 };

interface Props {
  seo?: SEOProps;
}

const { seo } = Astro.props;

const siteName = "Myles Kedrowski";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const description =
  seo?.description ?? settings.seoDescription ?? "Myles Kedrowski is the Art Director of Elegant Seagulls.";
---

<SEO
  title={seo?.title}
  noindex={seo?.noindex}
  description={description}
  canonical={canonicalURL}
  openGraph={{
    basic: {
      url: canonicalURL,
      title: seo?.title ?? siteName,
      type: "website",
      image: shareImage,
    },
    image: {
      url: shareImage,
      secureUrl: shareImage,
      alt: `${siteName}, Art Director`,
      ...shareSize,
    },
  }}
  extend={{
    link: [
      { rel: "icon", href: "/favicon.ico", sizes: "32x32" },
      { rel: "icon", href: "/favicon.svg", type: "image/svg+xml" },
      { rel: "apple-touch-icon", href: "/apple-touch-icon.png" },
      { rel: "manifest", href: "/site.webmanifest" },
    ],
    meta: [
      { name: "twitter:card", content: "summary_large_image" },
      { name: "twitter:image", content: shareImage },
      {
        name: "og:locale",
        content: "en_US",
      },
      {
        name: "og:description",
        content: description,
      },
      {
        name: "og:site_name",
        content: siteName,
      },
    ],
  }}
/>
