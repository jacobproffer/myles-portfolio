---
import { SEO, type Props as SEOProps } from "astro-seo";
import { getSiteSettings, urlFor } from "@lib/sanity";

const settings = await getSiteSettings();
const shareImage = settings.shareImage?.asset
  ? urlFor(settings.shareImage).width(1200).height(630).fit("crop").url()
  : new URL("/images/social.jpg", Astro.url).toString();
const shareSize = settings.shareImage?.asset ? { width: 1200, height: 630 } : { width: 800, height: 1200 };

interface Props {
  seo?: SEOProps;
}

const { seo } = Astro.props;

const siteName = "Myles Kedrowski";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const description =
  seo?.description ?? settings.seoDescription ?? "Myles Kedrowski is the Art Director of Elegant Seagulls.";
---

<SEO
  title={seo?.title}
  description={description}
  canonical={canonicalURL}
  openGraph={{
    basic: {
      url: canonicalURL,
      title: seo?.title ?? siteName,
      type: "website",
      image: shareImage,
    },
    image: {
      url: shareImage,
      secureUrl: shareImage,
      alt: "",
      ...shareSize,
    },
  }}
  extend={{
    meta: [
      {
        name: "og:locale",
        content: "en_US",
      },
      {
        name: "og:description",
        content: description,
      },
      {
        name: "og:site_name",
        content: siteName,
      },
    ],
  }}
/>
