---
/* A 3D text cylinder that rotates as you scroll. */
const items = [
  "Art Direction",
  "Brand Identity",
  "Digital Design",
  "Motion Systems",
  "Campaigns",
  "Type & Layout",
  "Creative Direction",
  "Art Direction",
  "Brand Identity",
  "Digital Design",
  "Motion Systems",
  "Campaigns",
];
---

<section class="relative h-[260vh]" data-cylinder-section>
  <div class="sticky top-0 flex h-svh flex-col justify-center overflow-hidden">
    <div class="grid-site label absolute inset-x-0 top-24">
      <p class="col-span-3 md:col-span-2">(03) — Capabilities</p>
      <p class="col-span-3 text-right text-mute md:col-span-2 md:col-start-11" data-cylinder-count>01 / 07</p>
    </div>

    <div class="relative mx-auto h-[1em] w-full text-[clamp(2.5rem,8.5vw,9rem)] [perspective:220vw]" aria-hidden="true">
      <div class="absolute inset-0 [transform-style:preserve-3d]" data-cylinder>
        {
          items.map((item) => (
            <div class="display absolute inset-x-0 top-0 text-center whitespace-nowrap [backface-visibility:hidden]" data-cylinder-item>
              {item}
            </div>
          ))
        }
      </div>
    </div>

    <ul class="sr-only">
      {[...new Set(items)].map((i) => <li>{i}</li>)}
    </ul>

    <div class="grid-site label absolute inset-x-0 bottom-[var(--margin)] text-mute">
      <p class="col-span-6 md:col-span-3">Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do eiusmod.</p>
      <p class="col-span-3 hidden text-right md:col-start-10 md:block">Keep scrolling</p>
    </div>

    <!-- corner ticks -->
    <span class="absolute top-1/2 left-[var(--margin)] h-px w-6 bg-hit"></span>
    <span class="absolute top-1/2 right-[var(--margin)] h-px w-6 bg-hit"></span>
  </div>
</section>
